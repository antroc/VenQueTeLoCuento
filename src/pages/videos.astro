---
import BaseLayout from '../layouts/BaseLayout.astro';
import reels from '../data/reels.json';
import categorias from '../data/categorias.json';
import { url } from '../lib/url';
import { miniaturas } from '../lib/miniaturas';

// Secciones en el mismo orden que la leyenda del mapa, sin categorías vacías.
// Dentro de cada una se respeta el orden de reels.json.
const secciones = categorias
  .map((cat) => ({ cat, videos: reels.filter((r) => r.categoria === cat.id) }))
  .filter((s) => s.videos.length > 0);

const total = reels.length;

// Miniaturas reducidas (480 px, webp) generadas en el build. Si una foto no
// existe todavía, se usa la ruta original y el onerror deja ver el icono.
const thumbs = await miniaturas(reels);

// Texto por el que busca el buscador: título + categoría, en minúsculas y sin
// tildes, para que «jeronimos» encuentre «Jerónimos». La misma normalización
// se aplica en el script a lo que teclea el usuario.
const normaliza = (s: string) =>
  s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
---

<BaseLayout
  title="Vídeos — ¡Ven, que te lo cuento!"
  description="Todos los reels de patrimonio de la Región de Murcia, agrupados por categoría."
>
  <section class="page-header">
    <div class="container">
      <h1>Vídeos</h1>
      <p>{total} lugares e historias de la Región de Murcia, agrupados por categoría</p>
    </div>
  </section>

  <section class="container videos-content">
    <!-- Barra pegajosa: buscador + categorías (estilos compartidos con
         Artículos en global.css). Se queda bajo la navegación al hacer
         scroll para poder saltar de categoría desde cualquier punto. -->
    <div class="toolbar">
      <input
        type="search"
        id="buscador"
        class="buscador"
        placeholder="Buscar vídeos…"
        aria-label="Buscar vídeos por título"
        autocomplete="off"
      />
      <div class="chips" role="group" aria-label="Filtrar por categoría">
        <button class="chip active" data-cat="all" aria-pressed="true">
          Todas <span class="chip-count">{total}</span>
        </button>
        {secciones.map(({ cat, videos }) => (
          <button class="chip" data-cat={cat.id} aria-pressed="false">
            <span class="chip-dot" style={`background: ${cat.color}`}></span>
            {cat.nombre} <span class="chip-count">{videos.length}</span>
          </button>
        ))}
      </div>
    </div>

    <p class="sin-resultados" hidden>No hay vídeos que encajen con esa búsqueda.</p>

    {secciones.map(({ cat, videos }) => (
      <section class="cat-section" data-cat={cat.id} id={cat.id}>
        <h2 class="cat-title">
          <span class="cat-badge" style={`background: ${cat.color}`} set:html={cat.icono} />
          {cat.nombre}
          <span class="cat-count-title">{videos.length}</span>
        </h2>

        <div class="videos-grid">
          {videos.map((reel) => (
            <article class="video-card" data-buscable={normaliza(`${reel.titulo} ${cat.nombre}`)}>
              <!-- La miniatura y el título llevan al mismo sitio: solo el título
                   es enlace accesible (como en el listado del blog). -->
              <a
                href={reel.urlReel}
                target="_blank"
                rel="noopener"
                class="video-thumb"
                style={`background: ${cat.color}`}
                tabindex="-1"
                aria-hidden="true"
              >
                <span class="thumb-icon" set:html={cat.icono} />
                <img
                  src={thumbs[reel.id] ?? url(reel.miniatura)}
                  alt=""
                  loading="lazy"
                  onerror="this.remove()"
                />
                <span class="thumb-insta">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </span>
                <span class="thumb-play">
                  <svg viewBox="0 0 24 24" width="34" height="34" fill="white"><path d="M8 5v14l11-7z"/></svg>
                  <span class="thumb-cta">Ver en Instagram ↗</span>
                </span>
              </a>
              <h3>
                <a
                  href={reel.urlReel}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Ver «${reel.titulo}» en Instagram (se abre en otra pestaña)`}
                >{reel.titulo}</a>
              </h3>
              <a class="map-link" href={url(`/?reel=${reel.id}#mapa`)}>
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 110-5 2.5 2.5 0 010 5z"/></svg>
                Ver en el mapa
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<script>
  const toolbar = document.querySelector<HTMLElement>('.toolbar')!;
  const filaChips = document.querySelector<HTMLElement>('.chips')!;
  const buscador = document.getElementById('buscador') as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const secciones = Array.from(document.querySelectorAll<HTMLElement>('.cat-section'));
  const aviso = document.querySelector<HTMLElement>('.sin-resultados')!;
  const navAltura = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-height')) || 64;

  const idsValidos = new Set(chips.map((c) => c.dataset.cat!));
  let catActiva = 'all';

  // Misma normalización que en el frontmatter (data-buscable).
  const normaliza = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  // La altura de la barra pegajosa, para que las anclas (#categoria) no
  // queden debajo de ella.
  function medirToolbar() {
    document.documentElement.style.setProperty('--toolbar-h', `${toolbar.offsetHeight}px`);
  }

  // En móvil los chips van en una fila con scroll horizontal: el activo se
  // centra para que no quede bajo el desvanecido del borde. En escritorio la
  // fila no tiene scroll y no hace nada.
  function centrarChip(chip: HTMLElement) {
    if (filaChips.scrollWidth <= filaChips.clientWidth) return;
    const fila = filaChips.getBoundingClientRect();
    const caja = chip.getBoundingClientRect();
    filaChips.scrollBy({ left: caja.left + caja.width / 2 - (fila.left + fila.width / 2) });
  }

  function aplicar() {
    const texto = normaliza(buscador.value.trim());
    let visibles = 0;

    secciones.forEach((sec) => {
      const pasaCat = catActiva === 'all' || sec.dataset.cat === catActiva;
      let enSeccion = 0;
      sec.querySelectorAll<HTMLElement>('.video-card').forEach((tarjeta) => {
        const pasaTexto = !texto || (tarjeta.dataset.buscable || '').includes(texto);
        const visible = pasaCat && pasaTexto;
        tarjeta.hidden = !visible;
        if (visible) enSeccion++;
      });
      sec.hidden = enSeccion === 0;
      visibles += enSeccion;
    });

    aviso.hidden = visibles > 0;

    chips.forEach((chip) => {
      const activo = chip.dataset.cat === catActiva;
      chip.classList.toggle('active', activo);
      chip.setAttribute('aria-pressed', String(activo));
      if (activo) centrarChip(chip);
    });
  }

  // Al filtrar, la página se acorta: llevamos al usuario a la barra para que
  // no se quede en un punto que ya no existe (o en medio de otra categoría).
  function irALaBarra() {
    const top = toolbar.getBoundingClientRect().top + window.scrollY - navAltura;
    if (window.scrollY > top) window.scrollTo({ top });
  }

  function activar(cat: string, desplazar: boolean) {
    catActiva = idsValidos.has(cat) ? cat : 'all';
    aplicar();
    if (desplazar) irALaBarra();
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.cat!;
      // replaceState en vez de location.hash: sin salto de ancla nativo ni
      // una entrada de historial por cada pulsación.
      const sinHash = window.location.pathname + window.location.search;
      history.replaceState(null, '', cat === 'all' ? sinHash : `#${cat}`);
      activar(cat, true);
    });
  });

  buscador.addEventListener('input', aplicar);

  // El hash filtra: /videos#semana-santa muestra solo esa categoría. Así llegan
  // los enlaces «Más vídeos de esta categoría →» del popup del mapa.
  function desdeHash() {
    const cat = decodeURIComponent(window.location.hash.slice(1));
    activar(cat, cat !== '');
  }

  window.addEventListener('hashchange', desdeHash);
  window.addEventListener('resize', medirToolbar);

  medirToolbar();
  desdeHash();
</script>

<style>
  /* La cabecera, la barra pegajosa (buscador + chips) y el aviso de «sin
     resultados» son estilos compartidos con Artículos: ver global.css. */

  .videos-content {
    padding-bottom: 4rem;
  }

  .cat-section {
    margin-bottom: 3rem;
    /* Para que al llegar por ancla (/videos#categoria) el título no quede
       oculto bajo la navegación ni bajo la barra pegajosa. */
    scroll-margin-top: calc(var(--nav-height) + var(--toolbar-h, 0px) + 1rem);
  }

  .cat-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.4rem;
    margin-bottom: 1.25rem;
  }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .cat-count-title {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: rgba(20, 20, 19, 0.06);
    padding: 0.15rem 0.6rem;
    border-radius: 12px;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.25rem;
  }

  .video-card h3 {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0.6rem 0 0.2rem;
  }

  .video-card h3 a {
    color: var(--color-text);
  }

  .video-card h3 a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 10px;
    overflow: hidden;
  }

  /* Icono de la categoría como fondo mientras no hay miniatura */
  .thumb-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.45;
  }

  .thumb-icon :global(svg) {
    width: 42px;
    height: 42px;
  }

  .video-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Glifo de Instagram siempre visible: avisa de que el vídeo se ve allí. */
  .thumb-insta {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(20, 20, 19, 0.55);
    color: #fff;
    z-index: 1;
  }

  .thumb-play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    background: rgba(20, 20, 19, 0.3);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .thumb-cta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    background: #fff;
    color: var(--color-text);
    white-space: nowrap;
  }

  .video-thumb:hover .thumb-play {
    opacity: 1;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .map-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
</style>
