---
import '../styles/global.css';
import reels from '../data/reels.json';
import categorias from '../data/categorias.json';
import { url } from '../lib/url';

// Herramienta de uso local. En el build de producción se sirve una página vacía
// para no publicarla en venquetelocuento.es.
const isDev = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <title>Añadir reels — herramienta local</title>
  {isDev && (
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  )}
</head>
<body>
  {!isDev ? (
    <div class="offline-notice">
      <h1>Herramienta local</h1>
      <p>
        El editor de reels solo funciona en tu ordenador. Arranca el proyecto con
        <code>npm run dev</code> y abre <code>localhost:4321/admin</code>.
      </p>
      <p><a href={url('/')}>Volver al mapa</a></p>
    </div>
  ) : (
    <div class="admin">
      <aside class="panel">
        <header class="panel-head">
          <h1>Editor de reels</h1>
          <p class="hint">Pincha en el mapa para situar el lugar</p>
        </header>

        <form id="reel-form" novalidate>
          <input type="hidden" id="f-id" />

          <div class="field">
            <label for="f-buscar">Buscar un lugar</label>
            <div class="search-row">
              <input
                type="text"
                id="f-buscar"
                placeholder="Catedral de Murcia, Castillo de Lorca…"
                autocomplete="off"
              />
              <button type="button" id="btn-buscar" class="btn-ghost">Buscar</button>
            </div>
            <ul id="search-results" class="search-results" hidden></ul>
          </div>

          <div class="field">
            <label for="f-titulo">Título <span class="req">*</span></label>
            <input type="text" id="f-titulo" placeholder="Catedral de Murcia" />
          </div>

          <div class="field">
            <label for="f-descripcion">Descripción <span class="req">*</span></label>
            <textarea id="f-descripcion" rows="2"
              placeholder="La impresionante fachada barroca de…"></textarea>
          </div>

          <div class="field">
            <label for="f-categoria">Categoría <span class="req">*</span></label>
            <select id="f-categoria">
              {categorias.map((cat) => (
                <option value={cat.id}>{cat.nombre}</option>
              ))}
            </select>
          </div>

          <div class="field">
            <label>Ubicación <span class="req">*</span></label>
            <div class="coords">
              <input type="number" id="f-lat" step="0.000001" placeholder="lat" />
              <input type="number" id="f-lng" step="0.000001" placeholder="lng" />
            </div>
            <p class="hint" id="coord-hint">Sin ubicación: pincha en el mapa</p>
          </div>

          <div class="field">
            <label for="f-url">Enlace al reel <span class="req">*</span></label>
            <input type="url" id="f-url" placeholder="https://www.instagram.com/reel/…" />
          </div>

          <div class="field">
            <label for="f-miniatura">Miniatura <span class="req">*</span></label>
            <input type="text" id="f-miniatura" placeholder="/img/reels/catedral-murcia.jpg" />
            <div class="thumb-row">
              <label class="btn-ghost file-btn">
                Elegir imagen…
                <input type="file" id="f-file" accept="image/*" hidden />
              </label>
              <img id="thumb-preview" alt="" hidden />
            </div>
            <p class="hint" id="thumb-hint">
              Recuerda copiar la imagen a <code>public/img/reels/</code>
            </p>
          </div>

          <div id="form-errors" class="errors" hidden></div>

          <div class="actions">
            <button type="submit" id="btn-guardar" class="btn">Añadir reel</button>
            <button type="button" id="btn-cancelar" class="btn-ghost" hidden>Cancelar</button>
          </div>
        </form>

        <section class="list-section">
          <div class="list-head">
            <h2>Reels <span id="count" class="count">0</span></h2>
            <span id="dirty-flag" class="dirty" hidden>sin guardar</span>
          </div>
          <ul id="reel-list" class="reel-list"></ul>
        </section>

        <footer class="panel-foot">
          <button type="button" id="btn-fs" class="btn" hidden>Guardar en reels.json</button>
          <button type="button" id="btn-descargar" class="btn-ghost">Descargar JSON</button>
          <button type="button" id="btn-copiar" class="btn-ghost">Copiar JSON</button>
          <p id="save-msg" class="save-msg" hidden></p>
        </footer>
      </aside>

      <div id="map"></div>
    </div>
  )}

  <style is:global>
    body {
      overflow: hidden;
    }

    .offline-notice {
      max-width: 32rem;
      margin: 6rem auto;
      padding: 0 1.5rem;
      text-align: center;
    }

    .offline-notice h1 {
      font-size: 1.6rem;
      margin-bottom: 0.75rem;
    }

    .offline-notice p {
      color: var(--color-text-secondary);
      margin-bottom: 0.75rem;
    }

    code {
      background: rgba(20, 20, 19, 0.07);
      padding: 0.1em 0.4em;
      border-radius: 4px;
      font-size: 0.9em;
    }

    .admin {
      display: grid;
      grid-template-columns: 380px 1fr;
      height: 100vh;
    }

    #map {
      height: 100vh;
      width: 100%;
    }

    .panel {
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      background: var(--color-bg);
      border-right: 1px solid var(--color-border);
    }

    .panel-head {
      padding: 1.25rem 1.25rem 0.5rem;
    }

    .panel-head h1 {
      font-size: 1.35rem;
    }

    .hint {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-top: 0.3rem;
    }

    #reel-form {
      padding: 0.5rem 1.25rem 1rem;
    }

    .field {
      margin-bottom: 0.85rem;
    }

    .field > label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
      color: var(--color-text-secondary);
    }

    .req {
      color: var(--color-accent);
    }

    input[type='text'],
    input[type='url'],
    input[type='number'],
    textarea,
    select {
      width: 100%;
      font-family: var(--font-sans);
      font-size: 0.88rem;
      padding: 0.5rem 0.6rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: #fff;
      color: var(--color-text);
    }

    input:focus,
    textarea:focus,
    select:focus {
      outline: 2px solid var(--color-accent);
      outline-offset: -1px;
      border-color: transparent;
    }

    textarea {
      resize: vertical;
    }

    .search-row {
      display: flex;
      gap: 0.4rem;
    }

    .coords {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.4rem;
    }

    .search-results {
      list-style: none;
      margin-top: 0.4rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }

    .search-results li {
      padding: 0.45rem 0.6rem;
      font-size: 0.8rem;
      cursor: pointer;
      border-bottom: 1px solid var(--color-border);
    }

    .search-results li:last-child {
      border-bottom: none;
    }

    .search-results li:hover {
      background: rgba(217, 119, 87, 0.1);
    }

    .btn,
    .btn-ghost {
      font-family: var(--font-sans);
      font-size: 0.83rem;
      font-weight: 600;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: opacity 0.2s;
      white-space: nowrap;
    }

    .btn {
      background: var(--color-accent);
      color: #fff;
    }

    .btn-ghost {
      background: transparent;
      color: var(--color-text-secondary);
      border-color: var(--color-border);
    }

    .btn:hover,
    .btn-ghost:hover {
      opacity: 0.85;
    }

    .btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .file-btn {
      display: inline-block;
    }

    .thumb-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.4rem;
    }

    #thumb-preview {
      width: 52px;
      height: 52px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--color-border);
    }

    .errors {
      background: rgba(217, 119, 87, 0.12);
      border-left: 3px solid var(--color-accent);
      border-radius: 6px;
      padding: 0.5rem 0.7rem;
      font-size: 0.78rem;
      margin-bottom: 0.75rem;
    }

    .errors ul {
      list-style: none;
    }

    .actions {
      display: flex;
      gap: 0.5rem;
    }

    .actions .btn {
      flex: 1;
    }

    .list-section {
      padding: 0 1.25rem 1rem;
      border-top: 1px solid var(--color-border);
    }

    .list-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 0 0.5rem;
    }

    .list-head h2 {
      font-size: 1rem;
    }

    .count {
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-text-muted);
    }

    .dirty {
      font-size: 0.7rem;
      font-weight: 600;
      color: #fff;
      background: var(--color-accent-secondary);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
    }

    .reel-list {
      list-style: none;
    }

    .reel-list li {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.45rem 0.5rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.83rem;
    }

    .reel-list li:hover {
      background: rgba(20, 20, 19, 0.05);
    }

    .reel-list li.editing {
      background: rgba(217, 119, 87, 0.14);
    }

    .reel-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .reel-name {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .reel-del {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--color-text-muted);
      font-size: 1rem;
      line-height: 1;
      padding: 0.15rem 0.3rem;
      border-radius: 4px;
    }

    .reel-del:hover {
      background: rgba(217, 119, 87, 0.2);
      color: var(--color-accent);
    }

    .panel-foot {
      margin-top: auto;
      padding: 0.9rem 1.25rem 1.25rem;
      border-top: 1px solid var(--color-border);
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .save-msg {
      flex-basis: 100%;
      font-size: 0.78rem;
      color: var(--color-text-muted);
    }

    .admin-marker {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: 3px solid #fff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
    }

    .admin-marker.draft {
      border-color: var(--color-accent);
      background: #fff !important;
      animation: pulse 1.6s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.18); }
    }

    @media (max-width: 820px) {
      body { overflow: auto; }
      .admin { grid-template-columns: 1fr; height: auto; }
      #map { height: 60vh; order: -1; }
      .panel { border-right: none; }
    }
  </style>

  {isDev && (
    <Fragment>
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script define:vars={{ reelsData: reels, categoriasData: categorias }}>
        let reels = structuredClone(reelsData);
        const categorias = categoriasData;
        const catById = new Map(categorias.map((c) => [c.id, c]));

        let editingId = null;
        let dirty = false;
        let fileHandle = null;
        let lastSearch = 0;

        const $ = (sel) => document.querySelector(sel);

        const form = $('#reel-form');
        const fId = $('#f-id');
        const fTitulo = $('#f-titulo');
        const fDescripcion = $('#f-descripcion');
        const fCategoria = $('#f-categoria');
        const fLat = $('#f-lat');
        const fLng = $('#f-lng');
        const fUrl = $('#f-url');
        const fMiniatura = $('#f-miniatura');
        const fFile = $('#f-file');
        const fBuscar = $('#f-buscar');
        const thumbPreview = $('#thumb-preview');
        const thumbHint = $('#thumb-hint');
        const coordHint = $('#coord-hint');
        const searchResults = $('#search-results');
        const errorBox = $('#form-errors');
        const listEl = $('#reel-list');
        const countEl = $('#count');
        const dirtyFlag = $('#dirty-flag');
        const btnGuardar = $('#btn-guardar');
        const btnCancelar = $('#btn-cancelar');
        const btnFs = $('#btn-fs');
        const saveMsg = $('#save-msg');

        /* ---------- mapa ---------- */

        const map = L.map('map').setView([37.98, -1.13], 9);

        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
          attribution:
            '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
          maxZoom: 20,
          subdomains: 'abcd',
        }).addTo(map);

        const markerLayer = L.layerGroup().addTo(map);
        let draftMarker = null;

        const makeIcon = (color, draft) =>
          L.divIcon({
            className: '',
            html: '<div class="admin-marker' + (draft ? ' draft' : '') +
                  '" style="background:' + color + '"></div>',
            iconSize: [26, 26],
            iconAnchor: [13, 13],
          });

        map.on('click', (e) => setCoords(e.latlng.lat, e.latlng.lng));

        function setCoords(lat, lng, fly) {
          fLat.value = lat.toFixed(6);
          fLng.value = lng.toFixed(6);
          coordHint.textContent =
            lat.toFixed(5) + ', ' + lng.toFixed(5) + ' — arrastra el marcador para ajustar';
          drawDraft(lat, lng);
          if (fly) map.setView([lat, lng], Math.max(map.getZoom(), 15));
        }

        function drawDraft(lat, lng) {
          const cat = catById.get(fCategoria.value);
          const color = cat ? cat.color : '#D97757';
          if (draftMarker) {
            draftMarker.setLatLng([lat, lng]);
            draftMarker.setIcon(makeIcon(color, true));
            return;
          }
          draftMarker = L.marker([lat, lng], { icon: makeIcon(color, true), draggable: true })
            .addTo(map)
            .on('dragend', (e) => {
              const p = e.target.getLatLng();
              setCoords(p.lat, p.lng);
            });
        }

        function clearDraft() {
          if (draftMarker) {
            map.removeLayer(draftMarker);
            draftMarker = null;
          }
          coordHint.textContent = 'Sin ubicación: pincha en el mapa';
        }

        function renderMarkers() {
          markerLayer.clearLayers();
          reels.forEach((r) => {
            if (r.id === editingId) return;
            const cat = catById.get(r.categoria);
            L.marker([r.lat, r.lng], { icon: makeIcon(cat ? cat.color : '#D97757', false) })
              .bindTooltip(r.titulo, { direction: 'top', offset: [0, -14] })
              .on('click', () => startEdit(r.id))
              .addTo(markerLayer);
          });
        }

        /* ---------- búsqueda de lugares (Nominatim) ---------- */

        async function buscarLugar() {
          const q = fBuscar.value.trim();
          if (q.length < 3) return;

          // La política de uso de Nominatim pide como mucho una petición por segundo.
          const ahora = Date.now();
          if (ahora - lastSearch < 1100) {
            saveMsg.textContent = 'Espera un segundo entre búsquedas.';
            saveMsg.hidden = false;
            return;
          }
          lastSearch = ahora;

          searchResults.innerHTML = '<li>Buscando…</li>';
          searchResults.hidden = false;

          try {
            const url =
              'https://nominatim.openstreetmap.org/search?format=json&limit=5&countrycodes=es&q=' +
              encodeURIComponent(q);
            const res = await fetch(url, { headers: { Accept: 'application/json' } });
            const data = await res.json();

            if (!data.length) {
              searchResults.innerHTML = '<li>Sin resultados</li>';
              return;
            }

            searchResults.innerHTML = '';
            data.forEach((item) => {
              const li = document.createElement('li');
              li.textContent = item.display_name;
              li.addEventListener('click', () => {
                setCoords(parseFloat(item.lat), parseFloat(item.lon), true);
                searchResults.hidden = true;
                if (!fTitulo.value.trim()) {
                  fTitulo.value = item.display_name.split(',')[0].trim();
                  sugerirMiniatura();
                }
              });
              searchResults.appendChild(li);
            });
          } catch (err) {
            searchResults.innerHTML = '<li>Error de conexión</li>';
          }
        }

        $('#btn-buscar').addEventListener('click', buscarLugar);
        fBuscar.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            buscarLugar();
          }
        });

        /* ---------- miniatura ---------- */

        function slugify(texto) {
          return texto
            .normalize('NFD')
            .replace(/[̀-ͯ]/g, '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
        }

        function sugerirMiniatura() {
          if (editingId) return;
          const slug = slugify(fTitulo.value);
          if (slug) fMiniatura.value = '/img/reels/' + slug + '.jpg';
        }

        fTitulo.addEventListener('input', sugerirMiniatura);

        fFile.addEventListener('change', () => {
          const file = fFile.files && fFile.files[0];
          if (!file) return;
          const ext = file.name.includes('.') ? file.name.split('.').pop() : 'jpg';
          const slug = slugify(fTitulo.value) || slugify(file.name.replace(/\.[^.]+$/, ''));
          fMiniatura.value = '/img/reels/' + slug + '.' + ext;
          thumbPreview.src = URL.createObjectURL(file);
          thumbPreview.hidden = false;
          thumbHint.innerHTML =
            'Copia <code>' + file.name + '</code> a <code>public' + fMiniatura.value + '</code>';
        });

        /* ---------- formulario ---------- */

        function siguienteId() {
          const max = reels.reduce((acc, r) => {
            const n = parseInt(r.id, 10);
            return Number.isNaN(n) ? acc : Math.max(acc, n);
          }, 0);
          return String(max + 1).padStart(3, '0');
        }

        function validar() {
          const errores = [];
          if (!fTitulo.value.trim()) errores.push('Falta el título.');
          if (!fDescripcion.value.trim()) errores.push('Falta la descripción.');
          if (!fCategoria.value) errores.push('Elige una categoría.');

          const lat = parseFloat(fLat.value);
          const lng = parseFloat(fLng.value);
          if (Number.isNaN(lat) || Number.isNaN(lng)) {
            errores.push('Falta la ubicación: pincha en el mapa.');
          } else if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
            errores.push('Las coordenadas están fuera de rango.');
          }

          const url = fUrl.value.trim();
          if (!url) {
            errores.push('Falta el enlace al reel.');
          } else if (!/^https:\/\/(www\.)?instagram\.com\/(reel|p)\//.test(url)) {
            errores.push('El enlace debería ser https://www.instagram.com/reel/…');
          }

          if (!fMiniatura.value.trim()) errores.push('Falta la miniatura.');

          return errores;
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const errores = validar();

          if (errores.length) {
            errorBox.innerHTML =
              '<ul>' + errores.map((x) => '<li>· ' + x + '</li>').join('') + '</ul>';
            errorBox.hidden = false;
            return;
          }
          errorBox.hidden = true;

          const datos = {
            id: fId.value || siguienteId(),
            titulo: fTitulo.value.trim(),
            descripcion: fDescripcion.value.trim(),
            categoria: fCategoria.value,
            lat: parseFloat(parseFloat(fLat.value).toFixed(6)),
            lng: parseFloat(parseFloat(fLng.value).toFixed(6)),
            miniatura: fMiniatura.value.trim(),
            urlReel: fUrl.value.trim(),
          };

          const idx = reels.findIndex((r) => r.id === datos.id);
          if (idx >= 0) reels[idx] = datos;
          else reels.push(datos);

          marcarSucio();
          resetForm();
        });

        btnCancelar.addEventListener('click', resetForm);

        function resetForm() {
          editingId = null;
          form.reset();
          fId.value = '';
          clearDraft();
          thumbPreview.hidden = true;
          thumbHint.innerHTML = 'Recuerda copiar la imagen a <code>public/img/reels/</code>';
          errorBox.hidden = true;
          searchResults.hidden = true;
          btnGuardar.textContent = 'Añadir reel';
          btnCancelar.hidden = true;
          render();
        }

        function startEdit(id) {
          const reel = reels.find((r) => r.id === id);
          if (!reel) return;

          editingId = id;
          fId.value = reel.id;
          fTitulo.value = reel.titulo;
          fDescripcion.value = reel.descripcion;
          fCategoria.value = reel.categoria;
          fUrl.value = reel.urlReel;
          fMiniatura.value = reel.miniatura;
          thumbPreview.src = reel.miniatura;
          thumbPreview.hidden = false;
          btnGuardar.textContent = 'Guardar cambios';
          btnCancelar.hidden = false;

          setCoords(reel.lat, reel.lng, true);
          render();
        }

        function borrar(id) {
          const reel = reels.find((r) => r.id === id);
          if (!reel) return;
          if (!confirm('¿Borrar "' + reel.titulo + '"?')) return;
          reels = reels.filter((r) => r.id !== id);
          if (editingId === id) {
            resetForm();
          } else {
            render();
          }
          marcarSucio();
        }

        /* ---------- listado ---------- */

        function render() {
          listEl.innerHTML = '';
          countEl.textContent = String(reels.length);

          reels.forEach((r) => {
            const li = document.createElement('li');
            if (r.id === editingId) li.classList.add('editing');

            const dot = document.createElement('span');
            dot.className = 'reel-dot';
            const cat = catById.get(r.categoria);
            dot.style.background = cat ? cat.color : '#D97757';

            const name = document.createElement('span');
            name.className = 'reel-name';
            name.textContent = r.titulo;

            const del = document.createElement('button');
            del.className = 'reel-del';
            del.type = 'button';
            del.textContent = '×';
            del.title = 'Borrar';
            del.addEventListener('click', (e) => {
              e.stopPropagation();
              borrar(r.id);
            });

            li.append(dot, name, del);
            li.addEventListener('click', () => startEdit(r.id));
            listEl.appendChild(li);
          });

          renderMarkers();
        }

        /* ---------- guardado ---------- */

        function serializar() {
          return JSON.stringify(reels, null, 2) + '\n';
        }

        function marcarSucio() {
          dirty = true;
          dirtyFlag.hidden = false;
          saveMsg.hidden = true;
        }

        function marcarLimpio(mensaje) {
          dirty = false;
          dirtyFlag.hidden = true;
          saveMsg.textContent = mensaje;
          saveMsg.hidden = false;
        }

        $('#btn-descargar').addEventListener('click', () => {
          const blob = new Blob([serializar()], { type: 'application/json' });
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'reels.json';
          a.click();
          URL.revokeObjectURL(a.href);
          marcarLimpio('Descargado. Reemplaza src/data/reels.json con el fichero.');
        });

        $('#btn-copiar').addEventListener('click', async () => {
          await navigator.clipboard.writeText(serializar());
          marcarLimpio('JSON copiado al portapapeles.');
        });

        // Guardado directo sobre el fichero del proyecto (Chrome y Edge).
        if ('showSaveFilePicker' in window) {
          btnFs.hidden = false;
          btnFs.addEventListener('click', async () => {
            try {
              if (!fileHandle) {
                fileHandle = await window.showSaveFilePicker({
                  suggestedName: 'reels.json',
                  types: [{ description: 'JSON', accept: { 'application/json': ['.json'] } }],
                });
              }
              const writable = await fileHandle.createWritable();
              await writable.write(serializar());
              await writable.close();
              marcarLimpio('Guardado en reels.json. Haz commit cuando termines.');
            } catch (err) {
              if (err.name !== 'AbortError') {
                saveMsg.textContent = 'No se pudo guardar: ' + err.message;
                saveMsg.hidden = false;
              }
            }
          });
        }

        window.addEventListener('beforeunload', (e) => {
          if (dirty) e.preventDefault();
        });

        fCategoria.addEventListener('change', () => {
          const lat = parseFloat(fLat.value);
          const lng = parseFloat(fLng.value);
          if (!Number.isNaN(lat) && !Number.isNaN(lng)) drawDraft(lat, lng);
        });

        render();
      </script>
    </Fragment>
  )}
</body>
</html>
