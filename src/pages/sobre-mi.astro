      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
    padding: 3rem 1.5rem 4rem;
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    background: var(--color-border);
  }

  .about-content h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .about-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .about {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-photo img {
      max-width: 200px;
      margin: 0 auto;
    }

    .social-links {
      justify-content: center;
    }
  }
</style>
