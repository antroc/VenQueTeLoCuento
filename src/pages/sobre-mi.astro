---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Sobre mí — ¡Ven que te lo cuento!">
  <section class="about container">
    <div class="about-photo">
      <img src={url('/img/perfil.jpg')} alt="Carmen Celdrán Gómez" />
    </div>

    <div class="about-content">
      <h1>Sobre mí</h1>

      <p>
        ¡Hola! Soy el creador de <strong>¡Ven que te lo cuento!</strong>, un proyecto dedicado a
        divulgar y poner en valor el patrimonio cultural de la Región de Murcia a través de
        reels en Instagram.
      </p>

      <p>
        Aquí encontrarás un mapa interactivo con todos los lugares que he visitado y grabado,
        además de artículos en el blog donde profundizo en la historia y curiosidades de estos
        rincones con encanto.
      </p>

      <!-- Edita este texto con tu bio real -->

      <div class="social-links">
        <a href="https://www.instagram.com/TU_CUENTA" target="_blank" rel="noopener" class="social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
          Instagram
        </a>
        <!-- Añade más redes sociales aquí -->
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
    padding: 3rem 1.5rem 4rem;
  }

  .about-photo img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 16px;
    background: var(--color-border);
  }

  .about-content h1 {
    font-size: 2.2rem;
    margin-bottom: 1rem;
  }

  .about-content p {
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 1rem;
    color: var(--color-text-secondary);
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .social-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .about {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-photo img {
      max-width: 200px;
      margin: 0 auto;
    }

    .social-links {
      justify-content: center;
    }
  }
</style>
