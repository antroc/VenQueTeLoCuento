---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={`${post.data.title} — ¡Ven que te lo cuento!`} description={post.data.description}>
  <article class="container article">
    <a href="/blog" class="back-link">← Volver al blog</a>

    <header>
      <time datetime={post.data.date.toISOString()}>
        {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      <h1>{post.data.title}</h1>
      <div class="post-tags">
        {post.data.tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    {post.data.images && post.data.images.length > 0 && (
      <div class="article-images">
        {post.data.images.map(img => (
          <img src={img} alt={post.data.title} loading="lazy" />
        ))}
      </div>
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding: 2rem 0 4rem;
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  header time {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  header h1 {
    font-size: 2.2rem;
    margin: 0.25rem 0 0.75rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.75rem;
    background: rgba(20, 20, 19, 0.06);
    padding: 0.25rem 0.7rem;
    border-radius: 12px;
    color: var(--color-text-muted);
  }

  .article-images {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .article-images img {
    width: 100%;
    border-radius: 12px;
    background: var(--color-border);
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 0.75rem;
  }

  .article-body :global(p) {
    margin-bottom: 1rem;
  }
</style>
