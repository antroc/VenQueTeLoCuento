---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Todos los artículos ordenados por fecha, para navegar entre ellos.
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const indice = posts.findIndex(p => p.slug === post.slug);
const masReciente = posts[indice - 1];
const masAntiguo = posts[indice + 1];

// "Te puede interesar": los que comparten más temas con este.
const relacionados = posts
  .filter(p => p.slug !== post.slug)
  .map(p => ({ p, comunes: p.data.tags.filter(t => post.data.tags.includes(t)).length }))
  .filter(x => x.comunes > 0)
  .sort((a, b) => b.comunes - a.comunes || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map(x => x.p);

// Tiempo de lectura estimado (~200 palabras por minuto).
const minutos = Math.max(1, Math.round(post.body.split(/\s+/).length / 200));

// La primera foto hace de cabecera; su copia en el cuerpo se oculta
// desde el script de abajo para no verla dos veces.
const portada = post.data.images?.[0];

// Datos estructurados para Google: esto es un artículo de Carmen,
// con su fecha, sus fotos y su URL.
const datosArticulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  ...(post.data.description ? { description: post.data.description } : {}),
  datePublished: post.data.date.toISOString(),
  inLanguage: 'es',
  image: (post.data.images ?? []).map(i => new URL(url(i), Astro.site).href),
  author: { '@type': 'Person', name: 'Carmen Celdrán Gómez' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={`${post.data.title} — ¡Ven, que te lo cuento!`}
  description={post.data.description}
  type="article"
  ogImage={portada}
  publishedDate={post.data.date}
>
  <script type="application/ld+json" set:html={JSON.stringify(datosArticulo)} />
  <article class="container article">
    <a href={url('/blog')} class="back-link">← Volver a los artículos</a>

    <header>
      <p class="article-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
      </p>
      <h1>{post.data.title}</h1>
      <div class="post-tags">
        {post.data.tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      {portada && <img class="portada" src={url(portada)} alt={post.data.title} />}
    </header>

    <div class="article-body" data-portada={portada ?? ''}>
      <Content />
    </div>

    <nav class="article-nav" aria-label="Otros artículos">
      {masAntiguo ? (
        <a href={url(`/blog/${masAntiguo.slug}`)} class="nav-ant">
          <span class="nav-dir">← Anterior</span>
          <span class="nav-titulo">{masAntiguo.data.title}</span>
        </a>
      ) : <span />}
      {masReciente ? (
        <a href={url(`/blog/${masReciente.slug}`)} class="nav-sig">
          <span class="nav-dir">Siguiente →</span>
          <span class="nav-titulo">{masReciente.data.title}</span>
        </a>
      ) : <span />}
    </nav>

    {relacionados.length > 0 && (
      <aside class="relacionados">
        <h2>Te puede interesar</h2>
        <div class="relacionados-grid">
          {relacionados.map(rel => (
            <a href={url(`/blog/${rel.slug}`)} class="rel-card">
              {rel.data.images?.[0] && (
                <img src={url(rel.data.images[0])} alt="" loading="lazy" />
              )}
              <span class="rel-titulo">{rel.data.title}</span>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>

  <div class="lightbox" id="lightbox" aria-hidden="true">
    <img src="" alt="" />
  </div>
</BaseLayout>

<script>
  // La foto de cabecera es la primera del cuerpo: se quita la copia
  // del cuerpo para no verla dos veces.
  const cuerpo = document.querySelector<HTMLElement>('.article-body');
  const rutaPortada = cuerpo?.dataset.portada;
  if (cuerpo && rutaPortada) {
    const duplicada = Array.from(cuerpo.querySelectorAll<HTMLImageElement>('figure img'))
      .find(img => img.src.endsWith(rutaPortada));
    duplicada?.closest('figure')?.remove();
  }

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = lightbox?.querySelector('img');

  document.querySelectorAll<HTMLImageElement>('.article-body img').forEach(img => {
    img.addEventListener('click', () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  const closeLightbox = () => {
    lightbox?.classList.remove('open');
    document.body.style.overflow = '';
  };

  lightbox?.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .article {
    padding: 2rem 0 4rem;
    max-width: 720px;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .article-meta {
    display: flex;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* Foto de cabecera del artículo. */
  .portada {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 12px;
    background: var(--color-border);
    margin-bottom: 2rem;
  }

  header h1 {
    font-size: 2.2rem;
    margin: 0.25rem 0 0.75rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.75rem;
    background: rgba(20, 20, 19, 0.06);
    padding: 0.25rem 0.7rem;
    border-radius: 12px;
    color: var(--color-text-muted);
  }

  .article-body {
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 0.75rem;
  }

  .article-body :global(p) {
    margin-bottom: 1rem;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  /* Letra capitular en el primer párrafo, aire de revista cultural. */
  .article-body > :global(p:first-of-type)::first-letter {
    font-family: var(--font-serif);
    font-size: 3.3em;
    font-weight: 700;
    float: left;
    line-height: 0.8;
    padding: 0.08em 0.12em 0 0;
    color: var(--color-accent);
  }

  .article-body :global(figure) {
    margin: 2rem auto;
    max-width: 560px;
    text-align: center;
  }

  .article-body :global(figure img) {
    width: 100%;
    border-radius: 10px;
    background: var(--color-border);
    cursor: zoom-in;
    transition: opacity 0.2s;
  }

  .article-body :global(figure img:hover) {
    opacity: 0.9;
  }

  .article-body :global(figcaption) {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    line-height: 1.4;
  }

  /* Navegación entre artículos, al pie. */
  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .article-nav a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .nav-sig {
    text-align: right;
  }

  .nav-dir {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .nav-titulo {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .article-nav a:hover .nav-titulo {
    color: var(--color-accent);
  }

  .article-nav a:hover {
    opacity: 1;
  }

  /* Artículos relacionados por tema. */
  .relacionados {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .relacionados h2 {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
  }

  .relacionados-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .rel-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 10px;
    background: var(--color-border);
    margin-bottom: 0.5rem;
    transition: opacity 0.2s;
  }

  .rel-card:hover img {
    opacity: 0.9;
  }

  .rel-card:hover {
    opacity: 1;
  }

  .rel-titulo {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
  }

  .rel-card:hover .rel-titulo {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .relacionados-grid {
      grid-template-columns: 1fr;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.88);
    cursor: zoom-out;
    padding: 1rem;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox img {
    max-width: 95vw;
    max-height: 92vh;
    border-radius: 6px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
</style>
