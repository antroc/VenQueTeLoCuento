---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Temas con su número de artículos, de más a menos frecuente.
const conteo: Record<string, number> = {};
posts.flatMap(p => p.data.tags).forEach(t => { conteo[t] = (conteo[t] || 0) + 1; });
const temas = Object.entries(conteo).sort((a, b) => b[1] - a[1]);

// Tiempo de lectura estimado (~200 palabras por minuto).
const minutos = (cuerpo: string) => Math.max(1, Math.round(cuerpo.split(/\s+/).length / 200));
---

<BaseLayout
  title="Artículos — ¡Ven, que te lo cuento!"
  description="Artículos sobre los lugares, historias y tradiciones de la Región de Murcia."
>
  <section class="page-header">
    <div class="container">
      <h1>Artículos</h1>
      <p>{posts.length} historias de patrimonio, arte y cultura de la Región de Murcia</p>
    </div>
  </section>

  <section class="container blog-content">
    <!-- Barra pegajosa: buscador + temas (estilos compartidos con Vídeos
         en global.css). -->
    <div class="toolbar">
      <input
        type="search"
        id="buscador"
        class="buscador"
        placeholder="Buscar artículos…"
        aria-label="Buscar artículos por título"
        autocomplete="off"
      />
      <div class="chips" role="group" aria-label="Filtrar por tema">
        <button class="chip active" data-tag="all" aria-pressed="true">Todos <span class="chip-count">{posts.length}</span></button>
        {temas.map(([tag, n]) => (
          <button class="chip" data-tag={tag} aria-pressed="false">{tag} <span class="chip-count">{n}</span></button>
        ))}
      </div>
    </div>

    <p class="sin-resultados" hidden>No hay artículos que encajen con esa búsqueda.</p>

    <div class="posts-grid">
      {posts.map((post, i) => (
        <article
          class:list={['post-card', { destacado: i === 0 }]}
          data-tags={post.data.tags.join(',')}
          data-buscable={`${post.data.title} ${post.data.description ?? ''}`.toLowerCase()}
        >
          {post.data.images?.[0] && (
            <a href={url(`/blog/${post.slug}`)} class="card-img" tabindex="-1" aria-hidden="true">
              <img src={url(post.data.images[0])} alt="" loading={i < 3 ? 'eager' : 'lazy'} />
            </a>
          )}
          <div class="post-card-body">
            <p class="post-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span aria-hidden="true">·</span>
              <span>{minutos(post.body)} min de lectura</span>
            </p>
            <h2><a href={url(`/blog/${post.slug}`)}>{post.data.title}</a></h2>
            {post.data.description && <p class="descripcion">{post.data.description}</p>}
            <div class="post-tags">
              {post.data.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const buscador = document.getElementById('buscador') as HTMLInputElement;
  const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));
  const aviso = document.querySelector<HTMLElement>('.sin-resultados')!;
  let temaActivo = 'all';

  function aplicar() {
    const texto = buscador.value.trim().toLowerCase();
    let visibles = 0;
    tarjetas.forEach(tarjeta => {
      const temas = (tarjeta.dataset.tags || '').split(',');
      const pasaTema = temaActivo === 'all' || temas.includes(temaActivo);
      const pasaTexto = !texto || (tarjeta.dataset.buscable || '').includes(texto);
      const visible = pasaTema && pasaTexto;
      tarjeta.style.display = visible ? '' : 'none';
      if (visible) visibles++;
    });
    aviso.hidden = visibles > 0;
  }

  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  chips.forEach(btn => {
    btn.addEventListener('click', () => {
      chips.forEach(b => {
        const activo = b === btn;
        b.classList.toggle('active', activo);
        b.setAttribute('aria-pressed', String(activo));
      });
      temaActivo = btn.dataset.tag!;
      aplicar();
    });
  });

  buscador.addEventListener('input', aplicar);
</script>

<style>
  /* La cabecera, la barra pegajosa (buscador + chips) y el aviso de «sin
     resultados» son estilos compartidos con Vídeos: ver global.css. */

  .blog-content {
    padding-bottom: 4rem;
  }

  /* Cuadrícula de revista: dos columnas y el artículo más reciente
     destacado a todo lo ancho. */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem 2rem;
  }

  .card-img {
    display: block;
  }

  .card-img img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 12px;
    background: var(--color-border);
    transition: opacity 0.2s;
  }

  .card-img:hover img {
    opacity: 0.9;
  }

  .post-card-body {
    margin-top: 0.75rem;
  }

  .post-meta {
    display: flex;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .post-card h2 {
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0.3rem 0 0.4rem;
  }

  .post-card h2 a {
    color: var(--color-text);
  }

  .post-card h2 a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .descripcion {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.7rem;
    background: rgba(20, 20, 19, 0.06);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    color: var(--color-text-muted);
  }

  /* El destacado ocupa las dos columnas, con la foto a la izquierda. */
  .post-card.destacado {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2rem;
    align-items: center;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card.destacado .card-img img {
    aspect-ratio: 16 / 11;
  }

  .post-card.destacado .post-card-body {
    margin-top: 0;
  }

  .post-card.destacado h2 {
    font-size: 1.9rem;
  }

  .post-card.destacado .descripcion {
    font-size: 1rem;
    -webkit-line-clamp: 4;
  }

  @media (max-width: 700px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .post-card.destacado {
      grid-template-columns: 1fr;
      gap: 0;
      align-items: start;
      padding-bottom: 2rem;
    }

    .post-card.destacado .post-card-body {
      margin-top: 0.75rem;
    }

    .post-card.destacado h2 {
      font-size: 1.5rem;
    }
  }
</style>
