---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();
---

<BaseLayout title="Blog — ¡Ven que te lo cuento!">
  <section class="blog-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Artículos sobre patrimonio, historia y cultura</p>
    </div>
  </section>

  <section class="container blog-content">
    <div class="tags-filter">
      <span class="tags-label">Filtrar:</span>
      {allTags.map(tag => (
        <button class="tag-btn" data-tag={tag}>{tag}</button>
      ))}
      <button class="tag-btn active" data-tag="all">Todos</button>
    </div>

    <div class="posts-grid">
      {posts.map(post => (
        <article class="post-card" data-tags={post.data.tags.join(',')}>
          {post.data.images?.[0] && (
            <img src={post.data.images[0]} alt={post.data.title} loading="lazy" />
          )}
          <div class="post-card-body">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            {post.data.description && <p>{post.data.description}</p>}
            <div class="post-tags">
              {post.data.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll('.tag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tag-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const tag = btn.dataset.tag;
      document.querySelectorAll('.post-card').forEach(card => {
        if (tag === 'all') {
          (card as HTMLElement).style.display = '';
        } else {
          const tags = card.getAttribute('data-tags')?.split(',') || [];
          (card as HTMLElement).style.display = tags.includes(tag!) ? '' : 'none';
        }
      });
    });
  });
</script>

<style>
  .blog-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.25rem;
  }

  .blog-header p {
    color: var(--color-text-muted);
  }

  .blog-content {
    padding-bottom: 4rem;
  }

  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .tags-label {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .tag-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    cursor: pointer;
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    transition: all 0.2s;
  }

  .tag-btn:hover,
  .tag-btn.active {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  .posts-grid {
    display: grid;
    gap: 2rem;
  }

  .post-card {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
  }

  .post-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 10px;
    background: var(--color-border);
  }

  .post-card-body time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-card-body h2 {
    font-size: 1.3rem;
    margin: 0.25rem 0 0.5rem;
  }

  .post-card-body h2 a {
    color: var(--color-text);
  }

  .post-card-body h2 a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .post-card-body p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .post-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.7rem;
    background: rgba(20, 20, 19, 0.06);
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
    }

    .post-card img {
      height: 200px;
    }
  }
</style>
