---
import { url, sinBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  /** 'article' en las páginas de artículo; 'website' en el resto. */
  type?: 'website' | 'article';
  /** Imagen para compartir propia de la página (ruta sin prefijo base). */
  ogImage?: string;
  /** Fecha de publicación, solo para artículos. */
  publishedDate?: Date;
}

const {
  title,
  description = '¡Ven, que te lo cuento! — Lugares, historias y tradiciones de la Región de Murcia, reel a reel',
  fullWidth = false,
  type = 'website',
  ogImage,
  publishedDate,
} = Astro.props;
const currentPath = sinBase(Astro.url.pathname);

// URL canónica de esta página: evita que Google vea duplicados. Todas las
// páginas se sirven como carpeta, así que siempre con barra final.
const rutaActual = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(rutaActual, Astro.site).href;

// Imagen para las tarjetas de WhatsApp, Instagram, etc. Debe ser una URL
// absoluta; se monta con el dominio de astro.config.mjs y el prefijo base.
// Cada artículo puede aportar la suya; si no, va la genérica del sitio.
const imagenOg = new URL(url(ogImage ?? '/img/og.jpg'), Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="¡Ven, que te lo cuento!" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:image" content={imagenOg} />
  {!ogImage && <meta property="og:image:width" content="1200" />}
  {!ogImage && <meta property="og:image:height" content="630" />}
  {type === 'article' && publishedDate && (
    <meta property="article:published_time" content={publishedDate.toISOString()} />
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <title>{title}</title>
</head>
<body class:list={[{ 'full-width': fullWidth }]}>
  <nav class="nav">
    <div class="nav-inner">
      <a href={url('/')} class="nav-brand">
        ¡Ven, que te lo cuento!
        <span class="nav-claim">por Carmen Celdrán Gómez</span>
      </a>
      <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        <li><a href={url('/')} class:list={[{ active: currentPath === '/' }]}>Mapa</a></li>
        <li><a href={url('/videos')} class:list={[{ active: currentPath.startsWith('/videos') }]}>Vídeos</a></li>
        <li><a href={url('/blog')} class:list={[{ active: currentPath.startsWith('/blog') }]}>Artículos</a></li>
        <li><a href={url('/sobre-mi')} class:list={[{ active: currentPath === '/sobre-mi/' || currentPath === '/sobre-mi' }]}>Sobre mí</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href={url('/')} class="footer-logo">¡Ven, que te lo cuento!</a>
        <p>Lugares, historias y tradiciones de la Región de Murcia</p>
      </div>

      <div class="footer-social">
        <a href="https://www.instagram.com/carmenceldran/" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://x.com/carmenceldran" target="_blank" rel="noopener" aria-label="X (antes Twitter)">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@carmencelgo" target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.88a8.28 8.28 0 004.76 1.5v-3.4a4.85 4.85 0 01-1-.29z"/></svg>
        </a>
      </div>

      <div class="footer-legal">
        <p>© {new Date().getFullYear()} ¡Ven, que te lo cuento! — Todos los derechos reservados</p>
        <a href={url('/politica-privacidad')}>Política de privacidad</a>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      links?.classList.toggle('open');
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: var(--color-dark);
    color: #fff;
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .nav-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
    /* Si la firma no cupiera (p. ej. mientras carga la fuente manuscrita),
       se recorta en vez de romper la barra. */
    min-width: 0;
    overflow: hidden;
  }

  .nav-brand:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  /* Firma manuscrita bajo el nombre del sitio. */
  .nav-claim {
    font-family: var(--font-hand);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #fff;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
    opacity: 1;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.2s;
  }

  main {
    margin-top: var(--nav-height);
  }

  body.full-width main {
    margin-top: 0;
  }

  body.full-width .nav {
    background: rgba(20, 20, 19, 0.85);
    backdrop-filter: blur(8px);
  }

  .footer {
    background: var(--color-dark);
    color: rgba(255, 255, 255, 0.7);
    padding: 3rem 0 2rem;
    font-size: 0.85rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    display: block;
    margin-bottom: 0.25rem;
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }

  .footer-social {
    display: flex;
    gap: 1.25rem;
  }

  .footer-social a {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
  }

  .footer-social a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .footer-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    width: 100%;
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: inline-block;
  }

  .footer-legal a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .nav-brand {
      font-size: 1.1rem;
    }

    .nav-claim {
      font-size: 0.85rem;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-dark);
      flex-direction: column;
      padding: 1rem 1.5rem;
      gap: 1rem;
    }

    .nav-links.open {
      display: flex;
    }
  }
</style>
