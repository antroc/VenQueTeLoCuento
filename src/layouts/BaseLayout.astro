---
interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = '¡Ven que te lo cuento! — Patrimonio cultural de la Región de Murcia en reels de Instagram', fullWidth = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body class:list={[{ 'full-width': fullWidth }]}>
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-brand">¡Ven que te lo cuento!</a>
      <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links">
        <li><a href="/" class:list={[{ active: currentPath === '/' }]}>Mapa</a></li>
        <li><a href="/blog" class:list={[{ active: currentPath.startsWith('/blog') }]}>Blog</a></li>
        <li><a href="/sobre-mi" class:list={[{ active: currentPath === '/sobre-mi/' || currentPath === '/sobre-mi' }]}>Sobre mí</a></li>
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="footer-logo">¡Ven que te lo cuento!</a>
        <p>Patrimonio cultural de la Región de Murcia</p>
      </div>

      <div class="footer-social">
        <a href="https://www.instagram.com/TU_CUENTA" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@TU_CUENTA" target="_blank" rel="noopener" aria-label="TikTok">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.88a8.28 8.28 0 004.76 1.5v-3.4a4.85 4.85 0 01-1-.29z"/></svg>
        </a>
        <a href="https://www.youtube.com/@TU_CUENTA" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>

      <div class="footer-legal">
        <p>© {new Date().getFullYear()} ¡Ven que te lo cuento! — Todos los derechos reservados</p>
        <a href="/politica-privacidad">Política de privacidad</a>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const links = document.querySelector('.nav-links');
    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      links?.classList.toggle('open');
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav-height);
    background: var(--color-dark);
    color: #fff;
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .nav-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #fff;
  }

  .nav-brand:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
    opacity: 1;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.2s;
  }

  main {
    margin-top: var(--nav-height);
  }

  body.full-width main {
    margin-top: 0;
  }

  body.full-width .nav {
    background: rgba(20, 20, 19, 0.85);
    backdrop-filter: blur(8px);
  }

  .footer {
    background: var(--color-dark);
    color: rgba(255, 255, 255, 0.7);
    padding: 3rem 0 2rem;
    font-size: 0.85rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    display: block;
    margin-bottom: 0.25rem;
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
  }

  .footer-social {
    display: flex;
    gap: 1.25rem;
  }

  .footer-social a {
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
  }

  .footer-social a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .footer-legal {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    width: 100%;
    text-align: center;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-legal a {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    margin-top: 0.25rem;
    display: inline-block;
  }

  .footer-legal a:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  @media (max-width: 640px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-dark);
      flex-direction: column;
      padding: 1rem 1.5rem;
      gap: 1rem;
    }

    .nav-links.open {
      display: flex;
    }
  }
</style>
